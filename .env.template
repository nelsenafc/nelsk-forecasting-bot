# =============================================================================
# Environment variables for the bot
#
#   1) Copy this file to `.env` in the same folder:  cp .env.template .env
#   2) Replace each REPLACE_ME with the real value.
#   3) `.env` is git-ignored. Never commit it. For GitHub Actions, add the same
#      names under Settings > Secrets and variables > Actions, or run:
#        gh secret set -f .env
# =============================================================================

# ---- REQUIRED -----------------------------------------------------------------
# Metaculus bot token: metaculus.com > Settings > My Forecasting Bots > Create a Bot
METACULUS_TOKEN=REPLACE_ME

# OpenRouter key. Metaculus hands out free credits through the participation form:
# https://forms.gle/aQdYMq9Pisrf1v7d8
OPENROUTER_API_KEY=REPLACE_ME

# ---- NEWS SEARCH [free for tournament bots via AskNews] -----------------------
# Generate at https://my.asknews.app/en/settings/api-credentials
ASKNEWS_API_KEY=REPLACE_ME

# ---- OPTIONAL OVERRIDES --------------------------------------------------------
# Change the forecaster line-up without touching code. Defaults in ensemble.py.
# FORECASTER_OPENAI_MODEL=openrouter/openai/gpt-6.1-sol
# FORECASTER_OPENAI_SAMPLES=2
# FORECASTER_ANTHROPIC_MODEL=openrouter/anthropic/claude-sonnet-5.5
# FORECASTER_ANTHROPIC_SAMPLES=1
# FORECASTER_GOOGLE_MODEL=openrouter/google/gemini-3.8-flash
# FORECASTER_GOOGLE_SAMPLES=2
# RESEARCH_MODEL=openrouter/openai/gpt-6.1-sol
# CHEAP_MODEL=openrouter/openai/gpt-6-luna
# Stop forecasting when the OpenRouter key has less than this many dollars left.
# MIN_CREDIT_USD=2
